{
  "name": "mumulib",
  "version": "2.0.0-alpha.1",
  "description": "mumulib builds web pages from single-file components and an app that keeps their state, with templates in plain HTML; its parts -- mumu, app, state, patslot, dialog, events, sync -- each import alone.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fzzzy/mumulib.git",
    "directory": "ts"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/browser/src/index.mjs",
  "types": "dist/types/index.d.ts",
  "bin": {
    "mumulib-sfc-check": "./dist/vite/sfc-check.mjs"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/esm/types/index.d.ts",
        "default": "./dist/browser/src/index.mjs"
      },
      "import": {
        "types": "./dist/esm/types/index.d.ts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      },
      "default": "./dist/browser/src/index.mjs"
    },
    "./state": {
      "browser": {
        "types": "./dist/esm/types/state.d.ts",
        "default": "./dist/browser/src/state.mjs"
      },
      "import": {
        "types": "./dist/esm/types/state.d.ts",
        "default": "./dist/esm/state.mjs"
      },
      "require": {
        "types": "./dist/types/state.d.ts",
        "default": "./dist/cjs/state.cjs"
      },
      "default": "./dist/browser/src/state.mjs"
    },
    "./patslot": {
      "browser": {
        "types": "./dist/esm/types/patslot.d.ts",
        "default": "./dist/browser/src/patslot.mjs"
      },
      "import": {
        "types": "./dist/esm/types/patslot.d.ts",
        "default": "./dist/esm/patslot.mjs"
      },
      "require": {
        "types": "./dist/types/patslot.d.ts",
        "default": "./dist/cjs/patslot.cjs"
      },
      "default": "./dist/browser/src/patslot.mjs"
    },
    "./dialog": {
      "browser": {
        "types": "./dist/esm/types/dialog.d.ts",
        "default": "./dist/browser/src/dialog.mjs"
      },
      "import": {
        "types": "./dist/esm/types/dialog.d.ts",
        "default": "./dist/esm/dialog.mjs"
      },
      "require": {
        "types": "./dist/types/dialog.d.ts",
        "default": "./dist/cjs/dialog.cjs"
      },
      "default": "./dist/browser/src/dialog.mjs"
    },
    "./events": {
      "browser": {
        "types": "./dist/esm/types/events.d.ts",
        "default": "./dist/browser/src/events.mjs"
      },
      "import": {
        "types": "./dist/esm/types/events.d.ts",
        "default": "./dist/esm/events.mjs"
      },
      "require": {
        "types": "./dist/types/events.d.ts",
        "default": "./dist/cjs/events.cjs"
      },
      "default": "./dist/browser/src/events.mjs"
    },
    "./sync": {
      "browser": {
        "types": "./dist/esm/types/sync.d.ts",
        "default": "./dist/browser/src/sync.mjs"
      },
      "import": {
        "types": "./dist/esm/types/sync.d.ts",
        "default": "./dist/esm/sync.mjs"
      },
      "require": {
        "types": "./dist/types/sync.d.ts",
        "default": "./dist/cjs/sync.cjs"
      },
      "default": "./dist/browser/src/sync.mjs"
    },
    "./mumu": {
      "browser": {
        "types": "./dist/esm/types/mumu.d.ts",
        "default": "./dist/browser/src/mumu.mjs"
      },
      "import": {
        "types": "./dist/esm/types/mumu.d.ts",
        "default": "./dist/esm/mumu.mjs"
      },
      "require": {
        "types": "./dist/types/mumu.d.ts",
        "default": "./dist/cjs/mumu.cjs"
      },
      "default": "./dist/browser/src/mumu.mjs"
    },
    "./app": {
      "browser": {
        "types": "./dist/esm/types/app.d.ts",
        "default": "./dist/browser/src/app.mjs"
      },
      "import": {
        "types": "./dist/esm/types/app.d.ts",
        "default": "./dist/esm/app.mjs"
      },
      "require": {
        "types": "./dist/types/app.d.ts",
        "default": "./dist/cjs/app.cjs"
      },
      "default": "./dist/browser/src/app.mjs"
    },
    "./node": {
      "import": {
        "types": "./dist/esm/types/node.d.ts",
        "default": "./dist/esm/node.mjs"
      },
      "require": {
        "types": "./dist/types/node.d.ts",
        "default": "./dist/cjs/node.cjs"
      }
    },
    "./vite-plugin-sfc": {
      "types": "./dist/esm/types/vite/sfc.d.mts",
      "import": "./dist/vite/sfc.mjs"
    },
    "./vite-plugin-origin": {
      "types": "./dist/esm/types/vite/origin.d.mts",
      "import": "./dist/vite/origin.mjs"
    },
    "./sfc-client": {
      "types": "./dist/types/vite/sfc-client.d.ts"
    },
    "./sfc-check": {
      "types": "./dist/esm/types/vite/sfc-check.d.mts",
      "import": "./dist/vite/sfc-check.mjs"
    }
  },
  "type": "commonjs",
  "scripts": {
    "start": "vite",
    "build": "rm -rf dist && vite build && vite build --mode node && tsc && node scripts/esm-types.mjs",
    "test": "npm run build && playwright test",
    "test:unit": "tsc --noEmit --module NodeNext --moduleResolution nodenext --target ES2020 --strict --skipLibCheck",
    "test:browser": "rm -rf .nyc_output && playwright test",
    "coverage": "nyc report --temp-dir .nyc_output --extension=.ts --extension=.html --reporter=text --reporter=html --report-dir coverage-frontend",
    "lint": "eslint . && prettier --config .prettierrc --check . ../README.md ../CHANGELOG.md ../design ../.github",
    "format": "eslint . --fix && prettier --config .prettierrc --write . ../README.md ../CHANGELOG.md ../design ../.github"
  },
  "keywords": [
    "html templating",
    "templating",
    "state management",
    "state",
    "form handling",
    "forms"
  ],
  "author": "Donovan Preston",
  "license": "MIT",
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-source-maps": "^4.0.4",
    "@types/morphdom": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/object-path": "^0.11.4",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-source-maps": "^5.0.6",
    "nyc": "^18.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-istanbul": "^9.0.1"
  },
  "dependencies": {
    "domino": "^2.1.8",
    "morphdom": "^2.7.8",
    "object-path": "^0.11.8"
  }
}
