{
  "name": "mumulib",
  "version": "1.0.16",
  "description": "mumulib is a simple typescript state management, html templating, and form processing library. It contains three modules: state, patslot, and dialog.",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/browser/src/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    "browser": {
      "types": "./dist/esm/types/index.d.ts",
      "default": "./dist/browser/src/index.mjs"
    },
    "import": {
      "types": "./dist/esm/types/index.d.ts",
      "default": "./dist/esm/index.mjs"
    },
    "require": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/cjs/index.cjs"
    },
    "default": "./dist/browser/src/index.mjs"
  },
  "type": "commonjs",
  "scripts": {
    "start": "node esbuild.mjs --serve",
    "build": "node esbuild.mjs",
    "test": "npm run build && playwright test",
    "test:unit": "tsc --noEmit --module NodeNext --moduleResolution nodenext --target ES2020 --strict --skipLibCheck",
    "test:browser": "playwright test"
  },
  "keywords": [
    "html templating",
    "templating",
    "state management",
    "state",
    "form handling",
    "forms"
  ],
  "author": "Donovan Preston",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/morphdom": "^2.3.0",
    "@types/node": "^22.8.6",
    "@types/object-path": "^0.11.4",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "domino": "^2.1.6",
    "morphdom": "^2.7.2",
    "object-path": "^0.11.8"
  }
}
